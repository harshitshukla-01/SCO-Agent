# Root Docker-compose env
COMPOSE_PROJECT_NAME=soc-agent

# Backend runtime values used by the app container
PROJECT_ID=soc-agent-7e94c
FIREBASE_AUTH_EMULATOR_HOST=emulators:9099
FIRESTORE_EMULATOR_HOST=emulators:8080
GOOGLE_APPLICATION_CREDENTIALS=
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Optional: required only for the local ngrok tunnel profile.
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
